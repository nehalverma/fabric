model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Date","Product","Reseller","Sales","Sales Order","Sales Territory"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop"]

ref table Customer
ref table 'Sales Territory'
ref table Product
ref table 'Sales Order'
ref table Sales
ref table Reseller
ref table Date

ref role Australia
ref role Canada

ref cultureInfo en-US

